{
  "name": "else-chat",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @else-chat/api",
    "dev:web": "npm run dev -w @else-chat/web",
    "build": "npm run build -w @else-chat/shared && npm run build -w @else-chat/api && npm run build -w @else-chat/web",
    "db:generate": "npm run prisma:generate -w @else-chat/api",
    "db:migrate": "npm run prisma:migrate -w @else-chat/api",
    "db:seed": "npm run prisma:seed -w @else-chat/api"
  },
  "engines": {
    "node": ">=20"
  }
}
