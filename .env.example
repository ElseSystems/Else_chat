# Database
POSTGRES_USER=elsechat
POSTGRES_PASSWORD=elsechat_secret
POSTGRES_DB=elsechat
DATABASE_URL=postgresql://elsechat:elsechat_secret@postgres:5432/elsechat?schema=public

# Redis
REDIS_URL=redis://redis:6379

# API
API_PORT=3001
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=/app/uploads
PUBLIC_API_URL=http://localhost:3001

# Evolution API
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=elsechat-evolution-key
EVOLUTION_WEBHOOK_URL=http://api:3001/webhooks/evolution

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# MinIO / S3 (optional — local disk used if unset)
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio123
# S3_BUCKET=elsechat
# S3_PUBLIC_URL=http://localhost:9000/elsechat
